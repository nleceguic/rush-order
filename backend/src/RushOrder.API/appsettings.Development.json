{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=rushorder_dev;Username=rushorder;Password=rushorder_dev_pass;Include Error Detail=true",
    "CommandTimeout": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "rush-order-api",
    "Audience": "rush-order-clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30,
    "PrivateKeyPath": "keys/private.pem",
    "PublicKeyPath": "keys/public.pem"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromName": "Rush Order Dev",
    "FromAddress": "noreply@rushorder.local",
    "UseSsl": false,
    "AdminEmail": "admin@rushorder.local"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "QrCode": {
    "BaseUrl": "http://localhost:3000/menu"
  },
  "Stripe": {
    "SecretKey": "sk_test_REPLACE_WITH_YOUR_TEST_KEY",
    "PublishableKey": "pk_test_REPLACE_WITH_YOUR_TEST_KEY",
    "WebhookSecret": "whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET",
    "ApplicationFeePercent": 0.005
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "ServiceBus": {
    "ConnectionString": "",
    "OrdersQueueName": "orders"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft":                              "Information",
        "Microsoft.EntityFrameworkCore.Database": "Information",
        "System":                                 "Warning",
        "Azure":                                  "Warning"
      }
    }
  }
}
