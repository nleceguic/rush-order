# Copiar a .env.production y completar antes de levantar docker-compose.prod.yml
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=rushorder
POSTGRES_USER=rushorder
POSTGRES_PASSWORD=changeme_use_a_strong_password

# ─── API ───────────────────────────────────────────────────────
API_PORT=5000
JWT_ISSUER=rush-order-api
JWT_AUDIENCE=rush-order-clients

# ─── PWA ───────────────────────────────────────────────────────
# VITE_API_URL y VITE_VAPID_PUBLIC_KEY se hornean en el bundle JS en build
# time: deben ser accesibles desde el navegador del cliente, no solo desde
# la red interna de docker. Usa la IP/dominio público del server.
PWA_PORT=3000
PWA_ORIGIN=http://YOUR_SERVER_IP:3000
VITE_API_URL=http://YOUR_SERVER_IP:5000/api
VITE_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
VITE_VAPID_PUBLIC_KEY=

# ─── Stripe (obligatorio — la API no arranca sin estas 3 claves) ───────────────
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── SMTP (opcional) ────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM_NAME=Rush Order
SMTP_FROM_ADDRESS=noreply@rushorder.local
SMTP_USE_SSL=true
SMTP_ADMIN_EMAIL=admin@rushorder.local

# ─── Observability (opcional) ───────────────────────────────────
APPINSIGHTS_CONNECTION_STRING=
