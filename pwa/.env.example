# URL base del API backend (sin /api al final)
VITE_API_URL=http://localhost:5000/api

# Token QR de mesa por defecto (para modo demo / fallback sin escanear QR)
# Mesa 1 del seed tiene un QrCode fijo (ver DatabaseSeeder.cs) para que este valor
# no quede obsoleto cada vez que se reseedea la base de datos.
VITE_RESTAURANT_ID=DEMOTABLE001

# Stripe — clave pública (pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Web Push VAPID — clave pública generada por el backend
VITE_VAPID_PUBLIC_KEY=
