# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=rushorder_dev
POSTGRES_USER=rushorder
POSTGRES_PASSWORD=rushorder_dev_pass
POSTGRES_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── pgAdmin ───────────────────────────────────────────────────
PGADMIN_EMAIL=admin@rushorder.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ─── MailHog ───────────────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ─── API ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# ─── JWT ───────────────────────────────────────────────────────
JWT_KEY=change_me_in_production_use_a_long_random_secret_key_here
JWT_ISSUER=rush-order-api
JWT_AUDIENCE=rush-order-clients
JWT_EXPIRY_MINUTES=60
